echo "🔧 Regenerando bundles antes del commit (npm run build:bundles)..."
npm run build:bundles

if [ $? -ne 0 ]; then
  echo "❌ El build de bundles falló. Commit abortado — revisá el error de arriba."
  exit 1
fi

# Vuelve a agregar los bundles regenerados al commit, así el commit siempre
# incluye el resultado del build actual (elimina el riesgo de bundles
# desactualizados por olvido humano — ver PERFORMANCE_AUDIT.md §6).
#
# FASE 5.1 (2026-08-08): la lista sale de
# scripts/listar-bundles-verificables.js (misma fuente que usa
# verificar-bundles.yml en CI) en vez de estar hardcodeada acá también
# — así un bundle nuevo (ej. los js/*.min.js de módulos) queda
# protegido en los dos lugares con un solo cambio.
git add $(node scripts/listar-bundles-verificables.js)

echo "✓ Bundles al día y agregados al commit."

echo "🔧 Regenerando sitemap.xml antes del commit (npm run sitemap)..."
npm run sitemap

if [ $? -ne 0 ]; then
  echo "❌ La generación del sitemap falló. Commit abortado — revisá el error de arriba."
  exit 1
fi

# Mismo motivo que con los bundles: sitemap.xml se genera a partir del
# contenido real del repo (páginas con canonical autoreferenciado +
# js/locales-slug.js) y no debe quedar desactualizado por olvido humano
# — ver auditoría 2026-08-06, hallazgo "sitemap.xml desactualizado".
git add sitemap.xml

echo "✓ Sitemap al día y agregado al commit."
