diff --git a/donde-comer-cdu/css/ficha.css b/donde-comer-cdu/css/ficha.css
index 2764c0e..739997c 100644
--- a/donde-comer-cdu/css/ficha.css
+++ b/donde-comer-cdu/css/ficha.css
@@ -37,6 +37,12 @@ body{background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif;f
 .hero-chips{display:flex;flex-wrap:wrap;gap:10px}
 .chip{padding:8px 18px;border:1px solid rgba(201,168,76,0.4);border-radius:2px;font-size:12px;letter-spacing:0.12em;color:rgba(255,255,255,0.85);text-transform:uppercase;font-weight:400;background:rgba(201,168,76,0.08)}
 .chip-gold{background:var(--gold);color:var(--ink);border-color:var(--gold);font-weight:600}
+/* Chip de rating de Google — deliberadamente distinto del chip-gold (URU SPOT)
+   para que no se confundan las dos fuentes: uno es nuestro puntaje editorial,
+   el otro es la calificación real de Google Maps, con su propio rótulo y link
+   de atribución a la ficha de Google. */
+.chip-google{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.85);border-color:rgba(255,255,255,0.25);text-decoration:none;transition:border-color var(--dur-rapido,0.2s) ease,background var(--dur-rapido,0.2s) ease}
+.chip-google:hover,.chip-google:focus-visible{background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.45)}
 .hero-score{position:absolute;top:50%;right:72px;transform:translateY(-50%);z-index:2;text-align:center;border:1px solid rgba(201,168,76,0.3);padding:28px 32px;background:rgba(13,13,13,0.6);backdrop-filter:blur(12px)}
 .score-num{font-family:'Cormorant Garamond',serif;font-size:64px;font-weight:300;color:var(--gold);line-height:1}
 .score-label{font-size:10px;letter-spacing:0.3em;color:rgba(255,255,255,0.5);text-transform:uppercase;margin-top:4px}
